

1. Setup your .env file
Create the file in your project root (and make sure to add .env to your .gitignore!):
text
WHATSAPP_PRIVATE_KEY_B64=LS0tLS1CRUdJTiBSU0EgUFJJVkFURS...[YOUR_BASE64_STRING]...
Use code with caution.

2. Install the Loader
.NET doesn't read .env files natively. The industry standard is DotNetEnv. DotNetEnv GitHub Repository
Run this command:
dotnet add package DotNetEnv
----------------------------
3. Load and Use in Program.cs
Call the loader at the very top of your Program.cs so the variables are available to your builder.Configuration.
csharp
using System.Security.Cryptography;
using System.Text;

// 1. Load the .env file into the system environment
DotNetEnv.Env.Load();

var builder = WebApplication.CreateBuilder(args);

// 2. Access it via Configuration (it looks in Environment Variables automatically)
string? base64Key = builder.Configuration["WHATSAPP_PRIVATE_KEY_B64"];

if (!string.IsNullOrEmpty(base64Key))
{
    // 3. Decode and Import
    string pemString = Encoding.UTF8.GetString(Convert.FromBase64String(base64Key));
    using var rsa = RSA.Create();
    rsa.ImportFromPem(pemString);
    
    // Now your RSA object is ready for WhatsApp decryption!
}
###################################################################


DotNetEnv.Env.Load(); // Load from file to system memory

var builder = WebApplication.CreateBuilder(args);

// Force the builder to see the new environment variables
builder.Configuration.AddEnvironmentVariables(); 

builder.Services.AddControllers();
// ... rest of your setup
Use code with caution.

Step 2: Access it in your Controller
Inject IConfiguration into your controller constructor. This is the standard .NET way to access settings from appsettings.json, .env, or Environment Variables. Microsoft Learn: Configuration in ASP.NET Core
csharp
using Microsoft.AspNetCore.Mvc;

[ApiController]
[Route("api/[controller]")]
public class FlowsController : ControllerBase
{
    private readonly IConfiguration _configuration;

    // The 'IConfiguration' is automatically provided by .NET
    public FlowsController(IConfiguration configuration)
    {
        _configuration = configuration;
    }

    [HttpPost("endpoint")]
    public IActionResult Endpoint()
    {
        // Access the key here!
        string? base64Key = _configuration["WHATSAPP_PRIVATE_KEY_B64"];

        if (string.IsNullOrEmpty(base64Key))
        {
            return BadRequest("Private key not found in environment.");
        }

        // Proceed with your logic...
        return Ok("Key found and ready!");
    }
}
