@page "/editgame"
@page "/editgame/{id:int}"
@inject NavigationManager NavigationManager
@inject GamesClient GamesClient
@inject GenreClient GenreClient
@using Gamestore.Frontend.Clients

<PageTitle>editgame</PageTitle>
@if(genres==null || game==null){
    <p><em>Loading...</em></p>
}else{

<div class="row">
    <h5>@title</h5>
    <div class="col">
        <EditForm Model="@game" FormName="editgame" OnValidSubmit="@Handlesubmit">
            <DataAnnotationsValidator/>
            <div class="mb-3">
                <label for="name" class="form-label">Name:</label>
                <InputText @bind-Value="game.Name"  class="form-control" id="name" />
                <ValidationMessage class="text-danger" For="@(()=>game.Name)" />
            </div>
            <div class="mb-3">
                <label for="genre" class="form-label">Genre:</label>
                <InputSelect @bind-Value="game.GenreId"  class="form-control" id="genre" >
                    <option value="">Select Genre</option>
                    @foreach(var genre in genres){
                        <option value="@genre.Id" >@genre.Name</option>
                    }
                </InputSelect>
            </div>
             <div class="mb-3">
                <label for="price" class="form-label">Price:</label>
                <InputNumber @bind-Value="game.Price"  class="form-control" id="price" />
            </div>
             <div class="mb-3">
                <label for="releaseDate" class="form-label">Release Date:</label>
                <InputDate @bind-Value="game.ReleaseDate"  class="form-control" id="releaseDate" />
            </div>
        
        <button type="submit" class="btn btn-primary">Submit</button>
        <a role="button" class="btn btn-danger" href="/">back to home</a>
        </EditForm>
    </div>
    <div class="col"></div>
</div>
}


@code {
    private string title=string.Empty;
    @* post user input *@
    @* private GameDetails game {get;set;} =new (); *@
    [Parameter]
    @* public string? id{get;set;} *@
    public int? id{get;set;}

    private GameDetails? game {get;set;}
    protected override void OnParametersSet()
    {
        @* 3:15:45 vid *@
        @* if(game is not null){
            return;
        } *@
        @* if(int.TryParse(id,out int gameid)){
            read one get on edit one
            game=GamesClient.GetGame(gameid);
        } *@
        if(id.HasValue){
            @* read one get on edit one *@
            game=GamesClient.GetGame(id.Value);
            title=$"Edit {game.Name}";
        }
        
        else{
            @* recevive game input *@
           game =new (){
                Name=string.Empty,
                ReleaseDate=DateOnly.FromDateTime(DateTime.UtcNow)
            };
            title="New Game";
        }
    }
    @* read get *@
    @* private GenreClient genreClient=new (); *@
    @* private GamesClient gamesClient=new (); *@
    private GenreModel[]? genres;
    protected override void OnInitialized()
    {
       genres=GenreClient.GetGenre(); 
    }

    public void Handlesubmit(){
        ArgumentNullException.ThrowIfNull(game);

        if(!id.HasValue){
        GamesClient.AddGames(game);
        }else{
            @* mannually parsing id *@
            game.Id=id.Value;
            GamesClient.UpdateGame(game);
        }
        NavigationManager.NavigateTo("/");
    }
}
