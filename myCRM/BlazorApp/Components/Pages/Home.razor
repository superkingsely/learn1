@page "/"
@inject HttpClient http

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<p>@apiResponse</p>

@code{
    private string? apiResponse;
    protected override async Task OnInitializedAsync()
    {
        await FetchData();
    }
    private async Task FetchData(){
        try{
            apiResponse=await http.GetStringAsync(requestUri: "http://localhost:5093/api/test/test");
        }catch(Exception ex){
            apiResponse=  $"exeption: {ex.Message}";
        }
    }
}
